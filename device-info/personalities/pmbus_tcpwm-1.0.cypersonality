        <Member name='intMask' value='`${isrEnable ? 1 : 0}`UL' />
        <Member name='vtrip' value='`${vtrip}`' />
        <Member name='slewRate' value='CY_GPIO_SLEW_FAST' />
        <Member name='driveSel' value='CY_GPIO_DRIVE_FULL' />
        <Member name='vregEn' value='`${(!hasSIO) ? "0UL" :
