      <ParamChoice id='sioRef' name='SIO Reference Voltage' group='Input' default='CY_SIO_VREF_PINREF' visible='`${hasSIO}`' editable='`${hasSIO}`' desc='Selects the reference voltage (Vref) trip point of the input buffer.' >
