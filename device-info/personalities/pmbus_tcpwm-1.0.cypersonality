        <Member name='vohSel' value='`${hasSIO ? sioVoltage : "0UL"}`' />
        <Member name='pullUpRes' value='`${pullUpRes}`' include='`${pullUpResAvailable}`'/>
        <Member name='nonSec' value='`${(secExtAvailable eq 1) ? nonSec : "1UL"}`' include='`${secExtAvailable ne -1}`'/>
      </ConfigStruct>

      <ConfigInstruction purpose='INITIALIZE' value='Cy_GPIO_Pin_Init(`${signalInstName}`_PORT, `${signalInstName}`_PIN, &amp;`${signalInstName}`_config);' include='true' />
    </ConfigFirmware>
