<PersonalityTemplate id='pmbus_tcpwm' name='PMBus' version='1.0' xmlns='http://cypress.com/xsd/cyhwpersonality_v12' >
  <Constants>
    <Const id='MIN_SCB_CLK_4DR_LE0K1_SM' value='1.55' />
    <Const id='MIN_SCB_CLK_4DR_LE0K4_SM' value='7.82' />
    <Const id='MIN_SCB_CLK_4DR_LE1K0_SM' value='15.84' />
    <Const id='MIN_SCB_CLK_4DR_LE1K0_MM' value='14.32' />

    <Const id='MAX_SCB_CLK_4DR_LE0K1_MM' value='3.2' />
    <Const id='MAX_SCB_CLK_4DR_LE0K4_MM' value='10.0' />
    <Const id='MAX_SCB_CLK_4DR_LE1K0_MM' value='25.8' />
    <Const id='MAX_SCB_CLK_4DR_LE0K1_SM' value='12.8' />
    <Const id='MAX_SCB_CLK_4DR_LE0K4_SM' value='15.38' />
    <Const id='MAX_SCB_CLK_4DR_LE1K0_SM' value='89.0' />

    <Const id='NUM_OF_DEFAULT_EXTRA_LINES' value='4' />
    <Const id='NUM_OF_CUSTOM_EXTRA_LINES' value='16' />

    <Const id='PMBUS_TIMEOUT_IN_SEC' value='0.025' />
    <Const id='MIN_I2C_THIGH_AT0K1_USEC' value='4.0' />
    <Const id='MIN_I2C_THIGH_AT0K4_USEC' value='0.6' />
    <Const id='MIN_I2C_THIGH_AT1K0_USEC' value='0.26' />
    <Const id='SCB_CLK_ACCURACY' value='0.1' /> <!-- 10% -->

    <Const id='PMBUS_STD_CMD_NUM' value='0' />
    <Const id='PMBUS_STD_CMD_MAX' value='255' /> <!-- The maximum value, as defined by the specification, is 256. However, it has been reduced to 255 due to implementation constraints. A variable that stores the number of standard PMBus commands is uint8_t, so the maximum value is 255. -->
    <Const id='PMBUS_EXT_CMD_NUM' value='2' />
    <Const id='PMBUS_EXT_CMD_MAX' value='255' /> <!-- The maximum value, as defined by the specification, is 256. However, it has been reduced to 255 due to implementation constraints. A variable that stores the number of extended PMBus commands is uint8_t, so the maximum value is 255. -->
    <Const id='PMBUS_TARGET_ADDRESS' value='32' />
    <Const id='PMBUS_PAGES_NUM' value='16' />
    <Const id='PMBUS_PAGES_MAX' value='32' />
    <Const id='PMBUS_PHASES_NUM' value='16' />
    <Const id='PMBUS_PHASES_MAX' value='128' />
    <Const id='PMBUS_ZONE_NUM' value='127' />
    <Const id='PMBUS_ZONE_MAX' value='191' />

    <Const id='PMBUS_CMD_CAP_DIR_WR' value='1' />
    <Const id='PMBUS_CMD_CAP_DIR_RD' value='2' />
    <Const id='PMBUS_CMD_CAP_DIR_PROCESS_CALL' value='4' />
    <Const id='PMBUS_CMD_CAP_BLOCK' value='8' />
    <Const id='PMBUS_CMD_CAP_PAGE' value='16' />
    <Const id='PMBUS_CMD_CAP_PHASE' value='32' />
    <Const id='PMBUS_CMD_CAP_MAX' value='63' />
    <Const id='PMBUS_INST_NUM_MAX' value='5' />
  </Constants>

  <VirtualResourceDefinition ipblock='VirtualResource' type='vres' count='1' >
    <VirtualResourceDefinition type='pmbus' display_name='PMBus' display_path='PMBus' display_mode='DYNAMIC' count='$PMBUS_INST_NUM_MAX' profile_fileName='pmbus' />
  </VirtualResourceDefinition>
  <FittingRules>
    <MappingRules>
      <IpBlock name='VirtualResource' />
      <Resource name='vres\.pmbus' />
    </MappingRules>
    <RoutingRules>
      <Connections>
        <Connection>
          <Port templateId='i2c_hw'  port='tr_i2c_scl_filtered[0]' />
          <Port templateId='tcpwmTimer' port='reload[0]' />
          <Port templateId='tcpwmTimer' port='stop[0]' />
        </Connection>
      </Connections>
    </RoutingRules>
  </FittingRules>

  <ExposedMembers />
  <Parameters>
    <!-- Debug/internal -->
    <ParamBool id='debug' name='debug' group='Internal' default='false' visible='false' editable='true' desc='' />
    <ParamBool id='intConfig' name='intConfig' group='Internal' default='false' visible='false' editable='`${debug}`' desc='' />
    <ParamString id='instName' name='instName' group='Internal' default='`${INST_NAME}`' visible='`${debug}`' editable='false' desc='' />
    <ParamRange id='instNum' name='instNum' group='Internal' default='`${getInstNumber("pmbus")}`' min='0' max='$PMBUS_INST_NUM_MAX' resolution='1' visible='`${debug}`' editable='false' desc='' />

    <ParamRange id="personalityInternalRevision" name="Personality internal revision" group="Internal" default="1" min="0" max="100" resolution="1" visible="`${intConfig}`" editable="false" desc="" />
    <ParamString id='null' name='null' group='Internal' default='' visible='`${debug}`' editable='false' desc='null string' />
    <ParamRange id='instCount' name='PMBus Instance Count' group='Internal' default='`${(isBlockUsed("vres[0].pmbus[0]") ? 1 : 0) + (isBlockUsed("vres[0].pmbus[1]") ? 1 : 0) + (isBlockUsed("vres[0].pmbus[2]") ? 1 : 0) + (isBlockUsed("vres[0].pmbus[3]") ? 1 : 0) + (isBlockUsed("vres[0].pmbus[4]") ? 1 : 0)}`' 
    min='0' max='$PMBUS_INST_NUM_MAX' resolution='1' visible='`${intConfig}`' editable='false' desc='The total number of PMBus instances' />
    <ParamRange id='expectedInstCount' name='Expected PMBus Instance Count' group='Internal' default='1' min='0' max='$PMBUS_INST_NUM_MAX' resolution='1' visible='`${intConfig}`' editable='true' desc='The number of PMBus instances configured by the PMBus Configurator.' />
    <ParamBool id='isConfigured' name='Is configured by Configurator' group='Internal' default='false' visible='`${intConfig}`' editable='true' desc='Tracks if this PMBus instance was configured by the PMBus configurator to guarantee the Compile Time Options integrity.' />

    <!-- Documentation Link -->
    <ParamDoc id='pmbusDoc' name='PMBus Documentation' group='General' default='file:///`${cy_libs_path()}`/docs/mtb_pmbus_overview/api_reference_manual.html' linkText='Link to PMBus Documentation' visible='true' desc='Link to PMBus Documentation' />

    <!-- PMBus Configurator -->
    <ParamCustom id='pmbusConf' name='PMBus Configurator' group='External Tools' path='`${cy_tools_path("pmbus-configurator") . "/pmbus-configurator"}`' visible='true' editable='true' desc='Launch the PMBus Configurator'>
      <Arg value='`${"--design=" . cy_design_file()}`' />
    </ParamCustom>

  <!-- General Configurations -->
  <!-- External Tool Interface for Code Generation -->
  <!-- "hw_config"  field components -->
  <ParamString id='hwCfgStructName' name='HW Config Struct Name' group='Configurator General/HW Config' default='`${instName}`_hw_config' visible='`${intConfig}`' editable='false' desc='The pointer to the hardware configuration structure.' />
  <ParamString id='halCfgStructName' name='HAL Config Struct Name' group='Configurator HAL Config' default='_hal_config' visible='`${intConfig}`' editable='true' desc='The pointer to HAL configuration structure.' />
  <ParamString id='hwResCtrlCallName' name='HW Resource Control Callback' group='Configurator General/HW Config' default='_hw_resource_ctrl' visible='`${intConfig}`' editable='true' desc='User callback to enable/disable I2C hardware.' />
  <ParamString id='hwIrqEnaCallName' name='HW IRQ Enable Callback' group='Configurator General/HW Config' default='_hw_irq_enable' visible='`${intConfig}`' editable='true' desc='User callback to enable I2C hardware interrupts.' />
  <ParamString id='hwIrqDisCallName' name='HW IRQ Disable Callback' group='Configurator General/HW Config' default='_hw_irq_disable' visible='`${intConfig}`' editable='true' desc='User callback to disable I2C hardware interrupts.' />

  <ParamString id='ctrlHwResEventCallName' name='Controller Events Callback' group='Configurator General/HW Config' default='_ctrl_events_ctrl' visible='`${intConfig}`' editable='true' desc='User callback to handle Controller events' />
  <ParamString id='ctrlHalCfgStructName' name='HAL Config Struct Name' group='Configurator HAL Config' default='_ctrl_hal_config' visible='`${intConfig}`' editable='true' desc='Pointer to HAL configuration structure' />
  <ParamString id='ctrlHwResCtrlCallName' name='HW Resource Control Callback' group='Configurator General/HW Config' default='_ctrl_hw_resource_ctrl' visible='`${intConfig}`' editable='true' desc='User callback to enable/disable I2C hardware.' />
  <ParamString id='ctrlHwIrqEnaCallName' name='HW IRQ Enable Callback' group='Configurator General/HW Config' default='_ctrl_hw_irq_enable' visible='`${intConfig}`' editable='true' desc='User callback to enable I2C hardware interrupts.' />
  <ParamString id='ctrlHwIrqDisCallName' name='HW IRQ Disable Callback' group='Configurator General/HW Config' default='_ctrl_hw_irq_disable' visible='`${intConfig}`' editable='true' desc='User callback to disable I2C hardware interrupts.' />

  <ParamBool id='pmbusEna' name='PMBus Support' group='Configurator General' default='true' visible='false' editable='true' desc='Enable PMBus functionality.' />
  <ParamBool id='ctrlEna' name='Controller Mode' group='Configurator General' default='false' visible='false' editable='true' desc='Enable Controller functionality.' />
  <ParamBool id='pmbusTrgtEnaInt' name='PMBus Target Mode' group='Configurator General' default='`${pmbusEna &amp;&amp; !ctrlEna}`' visible='false' editable='false' desc='Defines if PMBus Target mode is enabled.' />
  
  <ParamBool id='trgtHnpEna' name='Enable Host Notify Protocol' group='Configurator General' default='false' visible='false' editable='`${!ctrlEna}`' desc='Enable support of the host notify protocol.' />
  <ParamBool id='ctrlHnpEna' name='Enable Host Notify Protocol' group='Configurator General' default='false' visible='false' editable='`${ctrlEna}`' desc='Enable support of the host notify protocol.' />
  <ParamChoice id='pmbusSpeed' name='Data Rate' group='Configurator General' default='100' visible='false' editable='true' desc='PMBus communication speed'>
    <Entry name='100 kbps' value='100' visible='true' />
    <Entry name='400 kbps' value='400' visible='true' />
    <Entry name='1000 kbps' value='1000' visible='true' />
  </ParamChoice>

  <ParamString id='stdCmdTableName' name='Standard Command Table Name' group='Configurator General' default='_std_cmd_table' visible='`${intConfig}`' editable='true' desc='Symbol name for PMBus command table.' />
  <ParamRange id='stdCmdNum' name='Standard Command Number' group='Configurator General' default='`${ctrlEna ? 0 : $PMBUS_STD_CMD_NUM}`' min='0' max='255' resolution='1' visible='`${intConfig}`' editable='`${!ctrlEna}`' desc='The number of supported standard PMBus commands.' />
  <ParamBool id='pecEna' name='Enable Packet Error Checking' group='Configurator General' default='`${!ctrlEna}`' visible='`${intConfig}`' editable='`${!ctrlEna}`' desc='Enable the packet error checking.' />
  <ParamBool id='smbalertEna' name='Enable SMBAlert' group='Configurator General' default='`${!ctrlEna}`' visible='`${intConfig}`' editable='`${!ctrlEna}`' desc='Enable SMBAlert feature.' />
  <ParamBool id='genCallAddrRespEna' name='Enable General Call Address' group='Configurator General' default='`${!ctrlEna}`' visible='`${intConfig}`' editable='`${!ctrlEna}`' desc='Enables the response to the general call address (global broadcast).' />
  <ParamRange id='targetAddr' name='Target Address (7-bit)' group='Configurator General' default='`${$PMBUS_TARGET_ADDRESS + instNum}`' min='9' max='119' resolution='1' visible='`${intConfig}`' editable='true' desc='7-bit PMBus target address (R/W bit excluded)' />
  <ParamRange id='targetAddressMask' name='Target Address Mask (8-bit)' group='Configurator General' default='0' min='0' max='254' resolution='1' visible='`${intConfig}`' editable='true' desc='Specifies the PMBus target address mask. The range: 0x00-0xFE' />
  <ParamString id='genCallName' name='General Callback' group='Configurator General' default='_gen_callback' visible='`${intConfig}`' editable='true' desc='The custom handler name of a general event.' />
  <ParamString id='errCallName' name='Error Callback' group='Configurator General' default='_error_callback' visible='`${intConfig}`' editable='true' desc='The custom handler name of an error event.' />
  <ParamString id='trgtHnpCallName' name='Host Notify Protocol Callback' group='Configurator General' default='_hnp_callback' visible='`${intConfig}`' editable='true' desc='The custom handler name of a Host Notify Protocol.' />
  <ParamString id='ctrlHnpCallName' name='Host Notify Protocol Callback' group='Configurator General' default='_callback_hnp' visible='`${intConfig}`' editable='true' desc='The custom handler name of a Host Notify Protocol.' />
  <ParamBool id='extCmdEna' name='Enable Extended Commands' group='Configurator General' default='false' visible='`${intConfig}`' editable='`${pmbusEna}`' desc='Enables the extended commands support.' />
  <ParamString id='extCmdTableName' name='Extended Command Table Name' group='Configurator General' default='_ext_cmd_table' visible='`${intConfig &amp;&amp; extCmdEna}`' editable='true' desc='The symbol name for the extended command table.' />
  <ParamRange id='extCmdNum' name='Extended Command Number' group='Configurator General' default='`${extCmdEna ? $PMBUS_EXT_CMD_NUM : 0}`' min='0' max='255' resolution='1' visible='`${intConfig &amp;&amp; extCmdEna}`' editable='`${extCmdEna}`' desc='The number of the supported extended PMBus commands.' />
  <ParamChoice id='revNum' name='Revision Number' group='Configurator General' default='MTB_PMBUS_REVISION_1_4' visible='`${intConfig}`' editable='`${pmbusEna}`' desc='The supported revision number of PMBus specification.' >
    <Entry name='Revision 1.4' value='MTB_PMBUS_REVISION_1_4' visible='true' />
  </ParamChoice>

  <ParamBool id='ieeeEna' name='Enable IEEE Format' group='Configurator General' default='false' visible='`${intConfig}`' editable='`${pmbusEna}`' desc='Enable IEEE floating point format.' />
  <ParamRange id='pagesNum' name='Number of Pages' group='Configurator General' default='`${pmbusTrgtEnaInt ? $PMBUS_PAGES_NUM : 0}`' min='0' max='$PMBUS_PAGES_MAX' resolution='1' visible='`${intConfig}`' editable='`${pmbusTrgtEnaInt}`' desc='The total number of PMBus pages. If equal to 0, the pages are not supported' />
  <ParamRange id='phasesNum' name='Number of Phases' group='Configurator General' default='`${pmbusTrgtEnaInt ? $PMBUS_PHASES_NUM : 0}`' min='0' max='$PMBUS_PHASES_MAX' resolution='1' visible='`${intConfig}`' editable='`${pmbusTrgtEnaInt}`' desc='The total number of PMBus phases. If equal to 0, the phases are not supported.' />
  <ParamBool id='zoneEna' name='Enable Zone' group='Configurator General' default='`${pmbusTrgtEnaInt}`' visible='`${intConfig}`' editable='`${pmbusTrgtEnaInt}`' desc='Enable the Zone Write and Zone Read protocols support.' />
  <ParamString id='zoneCallName' name='Zone Callback' group='Configurator General' default='`${zoneEna ? "_zone_callback" : "NULL"}`' visible='`${intConfig}`' editable='`${zoneEna}`' desc='Zone protocol custom handler name' />
  <ParamBool id='pagesEnaInt' name='Pages Support' group='Internal' default='`${(pagesNum &gt; 0)}`' visible='`${intConfig}`' editable='false' desc='Enable page support.' />
  <ParamBool id='phasesEnaInt' name='Phases Support' group='Internal' default='`${(phasesNum &gt; 0)}`' visible='`${intConfig}`' editable='false' desc='Enable phase support.' />

  <!-- "impl_cmd_mask" field components -->
  <ParamBool id='pageCmdEna'          name='PAGE (0x00)'            group='Configurator General/Implemented Commands' default='`${pagesEnaInt}`'  visible='`${intConfig}`' editable='`${pagesEnaInt}`' desc='Enable the PAGE (0x00) command' />
  <ParamBool id='phaseCmdEna'         name='PHASE (0x04)'           group='Configurator General/Implemented Commands' default='`${phasesEnaInt}`'   visible='`${intConfig}`' editable='`${phasesEnaInt}`' desc='Enable the PHASE (0x04) command' />
  <ParamBool id='capabilityCmdEna'    name='CAPABILITY (0x19)'      group='Configurator General/Implemented Commands' default='`${pmbusEna}`'  visible='`${intConfig}`' editable='`${pmbusEna}`' desc='Enable the CAPABILITY (0x19) command' />
  <ParamBool id='queryCmdEna'         name='QUERY (0x1A)'           group='Configurator General/Implemented Commands' default='`${pmbusEna}`'  visible='`${intConfig}`' editable='`${pmbusEna}`' desc='Enable the QUERY (0x1A) command' />
  <ParamBool id='revisionCmdEna'      name='PMBUS_REVISION (0x98)'  group='Configurator General/Implemented Commands' default='`${pmbusEna}`'  visible='`${intConfig}`' editable='`${pmbusEna}`' desc='Enable the PMBUS_REVISION (0x98) command' />
  <ParamBool id='zoneConfigCmdEna'    name='ZONE_CONFIG (0x07)'     group='Configurator General/Implemented Commands' default='`${zoneEna}`'  visible='`${intConfig}`' editable='`${zoneEna}`' desc='Enable the ZONE_CONFIG (0x07) command' />
  <ParamBool id='zoneActiveCmdEna'    name='ZONE_ACTIVE (0x08)'     group='Configurator General/Implemented Commands' default='`${zoneEna}`'   visible='`${intConfig}`' editable='`${zoneEna}`' desc='Enable the ZONE_ACTIVE (0x08) command' />
  <ParamBool id='pagePlusWriteCmdEna' name='PAGE_PLUS_WRITE (0x05)' group='Configurator General/Implemented Commands' default='`${pagesEnaInt}`'  visible='`${intConfig}`' editable='`${pagesEnaInt}`' desc='Enable the PAGE_PLUS_WRITE (0x05) command' />
  <ParamBool id='pagePlusReadCmdEna'  name='PAGE_PLUS_READ (0x06)'  group='Configurator General/Implemented Commands' default='`${pagesEnaInt}`'  visible='`${intConfig}`' editable='`${pagesEnaInt}`' desc='Enable the PAGE_PLUS_READ (0x06) command' />
  <ParamBool id='p2PlusWriteCmdEna'   name='P2_PLUS_WRITE (0x09)'   group='Configurator General/Implemented Commands' default='`${pagesEnaInt &amp;&amp; phasesEnaInt}`' visible='`${intConfig}`' editable='`${pagesEnaInt &amp;&amp; phasesEnaInt}`' desc='Enable the P2_PLUS_WRITE (0x09) command' />
  <ParamBool id='p2PlusReadCmdEna'    name='P2_PLUS_READ (0x0A)'    group='Configurator General/Implemented Commands' default='`${pagesEnaInt &amp;&amp; phasesEnaInt}`'  visible='`${intConfig}`' editable='`${pagesEnaInt &amp;&amp; phasesEnaInt}`' desc='Enable the P2_PLUS_READ (0x0A) command' />

  <!-- External Tool Interface for Standard Command Table Code Generation -->
  <Repeat count='$PMBUS_STD_CMD_MAX'>
    <ParamBool id='stdCmd$idxEna' name='Enable' group='Configurator General/Standard Command$idx' default='`${$idx &lt; stdCmdNum}`' visible='`${intConfig}`' editable='`${pmbusEna}`' desc='Enable this command table entry' />
    <ParamBool id='stdCmd$idxVis' name='Visible' group='Configurator General/Standard Command$idx' default='`${intConfig}`' visible='`${intConfig}`' editable='false' desc='Defines visibility this command table entry' />
    <ParamString id='stdCmd$idxName' name='Function Name' group='Configurator General/Standard Command$idx' default='STD_COMMAND$idx' visible='`${stdCmd$idxVis}`' editable='`${stdCmd$idxEna}`' desc='Function name for this command' />
    <ParamRange id='stdCmd$idxCode' name='Command Code' group='Configurator General/Standard Command$idx' default='`${$idx}`' min='0x00' max='0xFF' resolution='0x01' visible='`${stdCmd$idxVis}`' editable='`${stdCmd$idxEna}`' desc='PMBus command code (uint8_t)' />
    <!-- "cmd_cap" field components -->
    <ParamRange id='stdCmd$idxBinCap' name='Std Cmd Capabilities' group='Configurator General/Standard Command$idx/Capabilities' default='0' min='0' max='$PMBUS_CMD_CAP_MAX' resolution='1' visible='`${stdCmd$idxVis}`' editable='`${stdCmd$idxEna}`' desc='Aggregated capabilities for standard commands' />
    <ParamChoice id='stdCmd$idxFormat' name='Data Format' group='Configurator General/Standard Command$idx/Capabilities' default='MTB_PMBUS_CMD_CAP_FORMAT_NO_NUM' visible='`${stdCmd$idxVis}`' editable='`${stdCmd$idxEna}`' desc='The numeric data format for this command.'>
      <Entry name='LINEAR11/ULINEAR16' value='MTB_PMBUS_CMD_CAP_FORMAT_LIN_11_16' visible='true' />
      <Entry name='16-bit Signed' value='MTB_PMBUS_CMD_CAP_FORMAT_16_BIT' visible='true' />
      <Entry name='IEEE Half Precision' value='MTB_PMBUS_CMD_CAP_FORMAT_IEEE' visible='`${ieeeEna || stdCmd$idxFormat eq MTB_PMBUS_CMD_CAP_FORMAT_IEEE}`' />
      <Entry name='Direct Mode' value='MTB_PMBUS_CMD_CAP_FORMAT_DIR_MODE' visible='true' />
      <Entry name='8-bit Unsigned' value='MTB_PMBUS_CMD_CAP_FORMAT_8_BIT' visible='true' />
      <Entry name='VID Mode' value='MTB_PMBUS_CMD_CAP_FORMAT_VID_MODE' visible='true' />
      <Entry name='Manufacturer Specific' value='MTB_PMBUS_CMD_CAP_FORMAT_MFC_SPEC' visible='true' />
      <Entry name='No Numeric Data' value='MTB_PMBUS_CMD_CAP_FORMAT_NO_NUM' visible='true' />
    </ParamChoice>
    <ParamString id='stdCmd$idxPagesNumArr' name='stdCmd$idxPagesNumArr' group='Internal' default='`${(stdCmd$idxBinCap &amp; $PMBUS_CMD_CAP_PAGE) &amp;&amp; (pagesNum &gt; 0) ? "[" . pagesNum . "U]" : ""}`' visible='`${debug}`' editable='false' desc='' />
    <ParamString id='stdCmd$idxPhasesNumArr' name='stdCmd$idxPhasesNumArr' group='Internal' default='`${(stdCmd$idxBinCap &amp; $PMBUS_CMD_CAP_PHASE) &amp;&amp; (phasesNum &gt; 0) ? "[" . phasesNum . "U]" : ""}`' visible='`${debug}`' editable='false' desc='' />
    <ParamString id='stdCmd$idxDataBuf' name='Data Buffer' group='Configurator General/Standard Command$idx' default='NULL' visible='`${stdCmd$idxVis}`' editable='`${stdCmd$idxEna}`' desc='The pointer to the command data buffer.' />
    <ParamRange id='stdCmd$idxDataSize' name='Data Size' group='Configurator General/Standard Command$idx' default='0' min='0' max='255' resolution='1' visible='`${stdCmd$idxVis}`' editable='`${stdCmd$idxEna}`' desc='Command data size (uint8_t)' />
    <ParamString id='stdCmd$idxCallback' name='Callback' group='Configurator General/Standard Command$idx' default='NULL' visible='`${stdCmd$idxVis}`' editable='`${stdCmd$idxEna}`' desc='Command callback function name' />
  </Repeat>

  <!-- External Tool Interface for Extended Command Table Code Generation -->
  <Repeat count='$PMBUS_EXT_CMD_MAX'>
    <ParamBool id='extCmd$idxEna' name='Enable' group='Configurator General/Extended Command$idx' default='`${($idx &lt; extCmdNum) &amp;&amp; extCmdEna}`' visible='`${intConfig &amp;&amp; extCmdEna}`' editable='false' desc='Enable this extended command table entry.' />
    <ParamBool id='extCmd$idxVis' name='Visible' group='Configurator General/Extended Command$idx' default='`${intConfig}`' visible='`${intConfig &amp;&amp; extCmdEna}`' editable='false' desc='Defines the visibility of this extended command table entry.' />
    <ParamString id='extCmd$idxName' name='Function Name' group='Configurator General/Extended Command$idx' default='EXT_COMMAND$idx' visible='`${extCmd$idxVis}`' editable='`${extCmd$idxEna}`'  desc='Function name for this extended command' />
    <ParamRange id='extCmd$idxCode' name='Command Code' group='Configurator General/Extended Command$idx' default='`${$idx}`' min='0x00' max='0xFF' resolution='0x01' visible='`${extCmd$idxVis}`' editable='`${extCmd$idxEna}`'  desc='PMBus extended command code (uint8_t)' />
    <!-- "cmd_cap" field components -->
    <ParamRange id='extCmd$idxBinCap' name='Ext Cmd Capabilities' group='Configurator General/Extended Command$idx/Capabilities' default='0' min='0' max='$PMBUS_CMD_CAP_MAX' resolution='1' visible='`${extCmd$idxVis}`' editable='`${extCmd$idxEna}`' desc='Aggregated capabilities for extended commands' />
    <ParamChoice id='extCmd$idxFormat' name='Data Format' group='Configurator General/Extended Command$idx/Capabilities' default='MTB_PMBUS_CMD_CAP_FORMAT_NO_NUM' visible='`${extCmd$idxVis}`' editable='`${extCmd$idxEna}`'  desc='The numeric data format for this extended command.'>
      <Entry name='LINEAR11/ULINEAR16' value='MTB_PMBUS_CMD_CAP_FORMAT_LIN_11_16' visible='true' />
